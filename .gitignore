# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.idea/
.claude/

# local Supabase CLI state
supabase/.temp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# real course content — not synthetic test data, kept out of git
fixtures/pptx/*.pptx

# real, currently-in-use teaching material (lecture decks, the actual
# Mock Test question bank with its answer key) — never public. Same
# reasoning as fixtures/pptx/ above, for the folder the instructor
# actually drops files into day-to-day.
/Class Materials CSE 1203/
scripts/data/question_bank.json

# generated dev/test account credentials
scripts/.dev-credentials.json

# ad-hoc debugging screenshots dropped in the repo root during dev sessions
/*.jpg
/*.jpeg
/*.png
