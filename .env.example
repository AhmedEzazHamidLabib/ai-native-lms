# Copy to .env.local and fill in from your Supabase project.
# All four are read from Project Settings in the Supabase dashboard.
#
# Uses Supabase's current API key format (sb_publishable_... /
# sb_secret_...), not the legacy JWT-based anon/service_role keys.

# Project Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Project Settings -> API -> Project API keys -> Publishable key
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API -> Project API keys -> Secret key
# NEVER expose to the browser. Bypasses Row Level Security.
# Only read server-side, in src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# Project Settings -> Database -> Connection string -> URI
# Use the "Direct connection" string (port 5432), NOT the pooled
# "Transaction" connection (port 6543) — DDL/migrations need a direct
# session, not a pgbouncer transaction-mode pool. Replace [YOUR-PASSWORD]
# with your project's database password (set at project creation, or
# resettable from that same Database settings page).
# Used only by scripts/*.mjs to run migrations — never imported by the app.
SUPABASE_DB_URL=

# https://console.anthropic.com/settings/keys
# Powers the AI Tutor (src/lib/tutor/provider.ts) and the Course
# Intelligence compile script (scripts/compile-course-intelligence.mjs).
# Optional for local development — the app runs fine without it, the
# Tutor just reports itself as unavailable.
ANTHROPIC_API_KEY=
